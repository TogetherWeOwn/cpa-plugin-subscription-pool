# Merge these non-secret fields into the deployed CLIProxyAPI config.
# The operator substitutes ZAI_CODING_PLAN_KEY and SYNTHETIC_API_KEY from the host secret channel;
# the rendered file must remain mode 0600 and must never enter git or logs.
claude-api-key:
  - api-key: ${ZAI_CODING_PLAN_KEY}
    base-url: https://api.z.ai/api/anthropic
    prefix: zai

openai-compatibility:
  # NVIDIA trial access/output is internal-evaluation-only, not production.
  # Keep the host lane disabled until permitted use, key, exact model access
  # and account-specific RPM are verified; supplying a key never activates it.
  - name: nvidia-nim
    disabled: true
    base-url: https://integrate.api.nvidia.com/v1
    api-key-entries:
      - api-key: ${NVIDIA_NIM_API_KEY}
    models:
      - name: z-ai/glm-5.3-flash
        alias: nvidia-nim/glm-5.3-flash
  # OpenRouter free models: the plugin keeps `models` equal to OpenRouter's current
  # free (:free, zero-price) list; leave it empty here. Enable by removing `disabled`
  # once the key and management-key-file below are in place.
  - name: openrouter-free
    disabled: true
    base-url: https://openrouter.ai/api/v1
    api-key-entries:
      - api-key: ${OPENROUTER_API_KEY}
    models: []
  - name: zai-coding-plan
    base-url: https://api.z.ai/api/coding/paas/v4
    api-key-entries:
      - api-key: ${ZAI_CODING_PLAN_KEY}
  - name: synthetic-infinite
    priority: -1
    base-url: https://api.synthetic.new/openai/v1
    api-key-entries:
      - api-key: ${SYNTHETIC_API_KEY}
    models:
      - name: "infinite:small:vision"
        alias: synthetic-infinite/deepseek-v4.1-flash
      - name: "infinite:small:vision"
        alias: synthetic/deepseek-v4.1-flash
  - name: synthetic
    base-url: https://api.synthetic.new/openai/v1
    api-key-entries:
      - api-key: ${SYNTHETIC_API_KEY}
    models:
      - name: "hf:deepseek-ai/DeepSeek-V4.1-Flash"
        alias: synthetic/deepseek-v4.1-flash

  # Disabled until a scoped token and account-wide GraphQL canary are verified.
  # Render both placeholders before applying; never send placeholders to a host.
  # The complete model catalog is in config.example.yaml.
  - name: cloudflare-workers-ai
    disabled: true
    base-url: https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1
    api-key-entries:
      - api-key: ${CLOUDFLARE_WORKERS_AI_TOKEN}
    models:
      - name: "@cf/qwen/qwen3-30b-a3b-fp8"
        alias: cloudflare-workers-ai/qwen3-30b-a3b-fp8
        max-context-length: 32768
        input-modalities: [text]
        thinking: {}
      - name: "@cf/zai-org/glm-4.7-flash"
        alias: cloudflare-workers-ai/glm-4.7-flash
        max-context-length: 131072
        input-modalities: [text]
        thinking: {}

plugins:
  enabled: true
  dir: /app/plugins
  store-sources:
    - https://github.com/TogetherWeOwn/cpa-plugin-subscription-pool/releases/download/v0.7.0/registry.json
  configs:
    subscription-pool:
      enabled: true
      priority: 1000
      cpa-config-path: /app/config.yaml
      providers:
        nvidia-nim:
          stayWithinFree: true
          free-tier-confirmed: false
          requests-per-minute: 0
          free-models: []
          free-request-limit: 0
        openrouter-free:
          stayWithinFree: true           # false drops only the local RPM/daily limits; never the :free-only rule
          requests-per-minute: 20        # OpenRouter's free-model limit; may only be lowered
          # daily-request-limit: 0       # optional LOWER cap; the limit itself comes from GET /api/v1/key (50 or 1000)
          sync-interval: 6h              # catalog poll; at least 10m
          catalog-max-age: 24h           # refuse requests if no catalog sync succeeded for this long
          # Models are reconciled through the host's management API (PATCH only `models`).
          # management-key-file holds the host management key (mode 0600); without it the
          # module still enforces free-only and limits but cannot update the host list.
          management-key-file: /app/auths/openrouter-free.management-key
          management-url: http://127.0.0.1:8317
        zai:
          quota-refresh-interval: 2m
          authoritative-max-age: 5m
          threshold-percent: 97
          suspend-duration: 30m
          fallback-cooldown: 10m
          state-retention: 192h
          default-plan: pro
          accounts:
            - key-suffix: ${ZAI_CODING_PLAN_KEY_SUFFIX}
              name: zai-pro-1
              plan: pro
              disabled: false
        synthetic:
          threshold-percent: 95
          quota-refresh-interval: 2m
          max-concurrent: 0
          infinite-max-concurrent: 0
        cloudflare-workers-ai:
          enabled: true
          stayWithinIncluded: true
          safety-margin-neurons: 500
          usage-refresh-interval: 30s
          usage-max-age: 2m
          providers: [cloudflare-workers-ai]
