# Merge these non-secret fields into the deployed CLIProxyAPI config.
# The operator substitutes ZAI_CODING_PLAN_KEY and SYNTHETIC_API_KEY from the host secret channel;
# the rendered file must remain mode 0600 and must never enter git or logs.
claude-api-key:
  - api-key: ${ZAI_CODING_PLAN_KEY}
    base-url: https://api.z.ai/api/anthropic
    prefix: zai

openai-compatibility:
  - name: zai-coding-plan
    base-url: https://api.z.ai/api/coding/paas/v4
    api-key-entries:
      - api-key: ${ZAI_CODING_PLAN_KEY}
  - name: synthetic-infinite
    priority: -1
    base-url: https://api.synthetic.new/openai/v1
    api-key-entries:
      - api-key: ${SYNTHETIC_API_KEY}
    models:
      - name: "infinite:small:vision"
        alias: synthetic-infinite/deepseek-v4.1-flash
      - name: "infinite:small:vision"
        alias: synthetic/deepseek-v4.1-flash
  - name: synthetic
    base-url: https://api.synthetic.new/openai/v1
    api-key-entries:
      - api-key: ${SYNTHETIC_API_KEY}
    models:
      - name: "hf:deepseek-ai/DeepSeek-V4.1-Flash"
        alias: synthetic/deepseek-v4.1-flash

plugins:
  enabled: true
  dir: /app/plugins
  store-sources:
    - https://github.com/TogetherWeOwn/cpa-plugin-subscription-pool/releases/download/v0.5.0/registry.json
  configs:
    subscription-pool:
      enabled: true
      priority: 1000
      cpa-config-path: /app/config.yaml
      providers:
        zai:
          quota-refresh-interval: 2m
          authoritative-max-age: 5m
          threshold-percent: 97
          suspend-duration: 30m
          fallback-cooldown: 10m
          state-retention: 192h
          default-plan: pro
          accounts:
            - key-suffix: ${ZAI_CODING_PLAN_KEY_SUFFIX}
              name: zai-pro-1
              plan: pro
              disabled: false
        synthetic:
          threshold-percent: 95
          quota-refresh-interval: 2m
          max-concurrent: 0
          infinite-max-concurrent: 0
